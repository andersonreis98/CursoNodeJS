<h1>Olá Handlebars!</h1>
<p>O nome do usuario é {{user.name}} {{user.surname}} e ele tem {{user.age}} anos.</p>
{{#if approved}}
    <p>PArabens seu usuario foi aprovado</p>
{{else}}
    <p>O seu cadastro necessita de aprovação para acessar o painel</p>
{{/if}}

{{#if auth}}
    <p>Usuário autenticado, <a href="/dashboard">Clique aqui</a> para acessar o painel</p>
{{/if}}