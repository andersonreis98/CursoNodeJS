<div id='book-page'>
	<a href='/books'>
		Voltar para a lista de livros
	</a>
	<h1>
		{{book.TITLE}}
	</h1>
	<p>
		Este livro tem {{book.PAGEQTY}} páginas.
	</p>
	<div class='actions'>
		<a href='/books/edit/{{book.ID}}'>
			Editar
		</a>
		<form action='/books/remove/{{book.ID}}' method='POST'>
			<input type='submit' value='Excluir' />
		</form>
	</div>
</div>