{{!-- título principal --}}
<h1>
	Editando o nome do usuario {{user.name}}
</h1>
{{!-- formulário que envia os dados para "/users/update/" usando o método POST --}}
<form action='/users/update/' method='POST' class='form'>
{{!-- campo escondido: envia "id" junto com o formulário sem aparecer na tela; o que está entre {{ }} é substituído pelo valor enviado pelo servidor --}}
<input type='hidden' name='id' value='{{user.id}}' />
	{{!-- agrupa o rótulo e o campo do formulário --}}
	<div class='form-control'>
		{{!-- rótulo do campo "name" --}}
		<label for='name'>
			Nome
		</label>
		{{!-- campo do tipo text; o valor chega no servidor com o nome "name"; o que está entre {{ }} é substituído pelo valor enviado pelo servidor --}}
		<input type='text' name='name' id='name' class='form-control' value='{{user.name}}' />
	</div>
	{{!-- agrupa o rótulo e o campo do formulário --}}
	<div class='form-control'>
		{{!-- rótulo do campo "occupation" --}}
		<label for='occupation'>
			Profissão
		</label>
		{{!-- campo do tipo text; o valor chega no servidor com o nome "occupation"; o que está entre {{ }} é substituído pelo valor enviado pelo servidor --}}
		<input type='text' name='occupation' id='occupation' placeholder='Digite a profissão' value='{{user.occupation}}' />
{{!-- bloco que agrupa elementos --}}
<div class="form-control form-checkbox">
    {{!-- mostra o bloco somente se "user.newsletter" for verdadeiro --}}
    {{#if user.newsletter}}
      {{!-- caixa de seleção (marcado/desmarcado) --}}
      <input type="checkbox" name="newsletter" checked>
    {{!-- senão (executa quando a condição/lista for falsa ou vazia) --}}
    {{else}}
      {{!-- caixa de seleção (marcado/desmarcado) --}}
      <input type="checkbox" name="newsletter">
    {{!-- fim do if --}}
    {{/if}}    
    {{!-- rótulo do campo "newsletter" --}}
    <label for="newsletter">Enviar promoções?</label>
  </div>
    {{!-- botão que envia o formulário --}}
    <input type="submit" value="Editar">
</form>
{{!-- bloco com a classe "address-container" (usada para estilizar no CSS) --}}
<div class="address-container">
  {{!-- subtítulo --}}
  <h2>Endereços</h2>
  {{!-- formulário que envia os dados para "/address/create" usando o método POST --}}
  <form action="/address/create" method="POST">
    {{!-- campo escondido: envia "UserId" junto com o formulário sem aparecer na tela; o que está entre {{ }} é substituído pelo valor enviado pelo servidor --}}
    <input type="hidden" name="UserId" value="{{user.id}}">
    {{!-- agrupa o rótulo e o campo do formulário --}}
    <div class="form-control">
      {{!-- rótulo do campo "street" --}}
      <label for="street">Rua:</label>
      {{!-- campo do tipo text; o valor chega no servidor com o nome "street" --}}
      <input type="text" name="street" placeholder="Digite a rua">
    </div>
    {{!-- agrupa o rótulo e o campo do formulário --}}
    <div class="form-control">
      {{!-- rótulo do campo "number" --}}
      <label for="number">Número:</label>
      {{!-- campo do tipo text; o valor chega no servidor com o nome "number" --}}
      <input type="text" name="number" placeholder="Digite o núemro da residência">
    </div>
    {{!-- agrupa o rótulo e o campo do formulário --}}
    <div class="form-control">
      {{!-- rótulo do campo "city" --}}
      <label for="city">Cidade:</label>
      {{!-- campo do tipo text; o valor chega no servidor com o nome "city" --}}
      <input type="text" name="city" placeholder="Digite a cidade">
    </div>
    {{!-- botão que envia o formulário --}}
    <input type="submit" value="Incluir endereço">
  </form>
  {{!-- bloco com a classe "address-list" (usada para estilizar no CSS) --}}
  <div class="address-list">
    {{!-- subtítulo --}}
    <h2>Lista de endereços:</h2>
    {{!-- percorre a lista "user.Addresses"; dentro do bloco, "this" é o item atual --}}
    {{#each user.Addresses}}
      {{!-- bloco que agrupa elementos; o que está entre {{ }} é substituído pelo valor enviado pelo servidor --}}
      <div>#{{this.id}} - {{this.street}} - {{this.number}} - {{this.city}}
        {{!-- formulário que envia os dados para "/address/delete" usando o método POST --}}
        <form action="/address/delete" method="POST">
          {{!-- campo escondido: envia "id" junto com o formulário sem aparecer na tela; o que está entre {{ }} é substituído pelo valor enviado pelo servidor --}}
          <input type="hidden" name="id" value="{{this.id}}">
          {{!-- botão que envia o formulário --}}
          <input type="submit" value="Excluir">
        </form>
      </div>
    {{!-- fim do loop each --}}
    {{/each}}
  </div>
</div>