{{!-- título principal --}}
<h1>Todas as Tasks:</h1>
{{!-- lista não ordenada --}}
<ul class="task-list">
  {{!-- mostra o bloco somente se "emptyTasks" for verdadeiro --}}
  {{#if emptyTasks}}
    {{!-- parágrafo de texto --}}
    <p>Não há tarefas cadastradas</p>
  {{!-- fim do if --}}
  {{/if}}
  {{!-- percorre a lista "tasks"; dentro do bloco, "this" é o item atual --}}
  {{#each tasks}}
    {{!-- item da lista --}}
    <li>
      {{!-- mostra o bloco somente se "this.done" for verdadeiro --}}
      {{#if this.done}}
        {{!-- link para /tasks/edit/{{this.id}}; o que está entre {{ }} é substituído pelo valor enviado pelo servidor --}}
        <a href="/tasks/edit/{{this.id}}" class="title done">{{this.title}}</a>
      {{!-- senão (executa quando a condição/lista for falsa ou vazia) --}}
      {{else}}
        {{!-- link para /tasks/edit/{{this.id}}; o que está entre {{ }} é substituído pelo valor enviado pelo servidor --}}
        <a href="/tasks/edit/{{this.id}}" class="title">{{this.title}}</a>
      {{!-- fim do if --}}
      {{/if}}
      {{!-- trecho de texto em linha --}}
      <span class="actions">
        {{!-- formulário que envia os dados para "/tasks/updatestatus" usando o método POST --}}
        <form action="/tasks/updatestatus" method="POST">
          {{!-- campo escondido: envia "id" junto com o formulário sem aparecer na tela; o que está entre {{ }} é substituído pelo valor enviado pelo servidor --}}
          <input type="hidden" name="id" value={{this.id}}>
          {{!-- campo escondido: envia "done" junto com o formulário sem aparecer na tela; o que está entre {{ }} é substituído pelo valor enviado pelo servidor --}}
          <input type="hidden" name="done" value={{this.done}}>
          {{!-- botão que envia o formulário --}}
          <button type="submit">
            {{!-- ícone "check2" do Bootstrap Icons --}}
            <i class="bi bi-check2"></i>
          </button>
        </form>
        {{!-- link para /tasks/edit/{{this.id}}; o que está entre {{ }} é substituído pelo valor enviado pelo servidor --}}
        <a href="/tasks/edit/{{this.id}}"><i class="bi bi-pencil-square"></i></a>
        {{!-- formulário que envia os dados para "/tasks/remove" usando o método POST --}}
        <form action="/tasks/remove" method="POST">
          {{!-- campo escondido: envia "id" junto com o formulário sem aparecer na tela; o que está entre {{ }} é substituído pelo valor enviado pelo servidor --}}
          <input type="hidden" name="id" value={{this.id}}>
          {{!-- botão que envia o formulário --}}
          <button type="submit">
            {{!-- ícone "x-lg" do Bootstrap Icons --}}
            <i class="bi bi-x-lg"></i>
          </button>
        </form>
      </span>
    </li>
  {{!-- fim do loop each --}}
  {{/each}}
</ul>