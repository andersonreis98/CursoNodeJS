{{!-- bloco com a classe "Pensamento-form-container" (usada para estilizar no CSS) --}}
<div class="Pensamento-form-container">
  {{!-- link para /Pensamentos/dashboard --}}
  <a href="/Pensamentos/dashboard">Voltar</a>
  {{!-- título principal --}}
  <h1>Editando um Pensamento:</h1>
  {{!-- formulário que envia os dados para "/Pensamentos/edit" usando o método POST --}}
  <form action="/Pensamentos/edit" method="POST">
    {{!-- campo escondido: envia "id" junto com o formulário sem aparecer na tela; o que está entre {{ }} é substituído pelo valor enviado pelo servidor --}}
    <input type="hidden" name="id" value={{Pensamento.id}}>
    {{!-- agrupa o rótulo e o campo do formulário --}}
    <div class="form-control">
        {{!-- rótulo do campo "title" --}}
        <label for="title">Título:</label>
        {{!-- campo do tipo text; o valor chega no servidor com o nome "title"; o que está entre {{ }} é substituído pelo valor enviado pelo servidor --}}
        <input type="text" name="title" placeholder="Digite o título" value="{{Pensamento.title}}">
    </div>
    {{!-- botão que envia o formulário --}}
    <input type="submit" value="Editar Pensamento">
  </form>
</div>