{{!-- bloco com a classe "product-page" (usada para estilizar no CSS) --}}
<div class="product-page">
  {{!-- link para / --}}
  <a href="/">Voltar</a>
  {{!-- título principal; o que está entre {{ }} é substituído pelo valor enviado pelo servidor --}}
  <h1>{{product.name}}</h1>
  {{!-- parágrafo de texto; o que está entre {{ }} é substituído pelo valor enviado pelo servidor --}}
  <p>Preço: R${{product.price}}</p>
  {{!-- imagem cujo endereço vem dos dados enviados à view --}}
  <img src="{{product.image}}" alt="{{product.name}}">
  {{!-- parágrafo de texto; o que está entre {{ }} é substituído pelo valor enviado pelo servidor --}}
  <p>Descrição: {{product.description}}</p>
  {{!-- formulário que envia os dados para "/remove/{{product._id}}" usando o método POST --}}
  <form action="/remove/{{product._id}}" method="POST">
    {{!-- botão que envia o formulário --}}
    <input type="submit" class="btn" value="Excluir">
  </form>
</div>