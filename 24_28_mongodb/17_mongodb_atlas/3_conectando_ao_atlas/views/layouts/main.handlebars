<!DOCTYPE html>
{{!-- declara que o documento é HTML5 --}}
{{!-- elemento raiz da página; "lang" indica o idioma --}}
<html lang="en">
{{!-- cabeçalho: informações da página que não aparecem no corpo --}}
<head>
  {{!-- codificação de caracteres (UTF-8 aceita acentos) --}}
  <meta charset="UTF-8">
  {{!-- pede ao navegador Edge/IE o modo de renderização mais recente --}}
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  {{!-- deixa a página responsiva em celulares --}}
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  {{!-- título que aparece na aba do navegador --}}
  <title>Notes</title>
  <!-- Bootstrap (framework de CSS) -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-wEmeIV1mKuiNpC+IOBjI7aAzPcEZeedi5yW5f2yOq55WWLwNGmvvx4Um1vskeMj0" crossorigin="anonymous">
  <!-- CSS -->
  <link rel="stylesheet" href="/css/styles.css">
</head>
{{!-- corpo: tudo que aparece na tela --}}
<body>
  {{!-- barra de navegação --}}
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    {{!-- bloco com a classe "container-fluid" (usada para estilizar no CSS) --}}
    <div class="container-fluid">
      {{!-- nome/logo do site com link para a página inicial --}}
      <a class="navbar-brand" href="/">Notes</a>
          {{!-- botão "hambúrguer" que abre o menu em telas pequenas (Bootstrap) --}}
          <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            {{!-- ícone do botão do menu --}}
            <span class="navbar-toggler-icon"></span>
          </button>
          {{!-- área do menu que recolhe em telas pequenas --}}
          <div class="collapse navbar-collapse" id="navbarNav">
            {{!-- lista não ordenada --}}
            <ul class="navbar-nav">
              {{!-- item do menu --}}
              <li class="nav-item">
                {{!-- link para a lista de notas --}}
                <a class="nav-link" aria-current="page" href="/">Minhas Notas</a>
              </li>
              {{!-- item do menu --}}
              <li class="nav-item">
                {{!-- link para o formulário de nova nota --}}
                <a class="nav-link" aria-current="page" href="/notes">Adicionar Nota</a>
              </li>
            </ul>
          </div>
    </div>
  </nav>
  {{!-- bloco com o id "main-container" --}}
  <div id="main-container" class="container">
    {{!-- aqui o Handlebars injeta o conteúdo de cada view (três chaves = HTML sem escapar) --}}
    {{{ body }}}
  </div>
  {{!-- rodapé da página --}}
  <footer class="bg-dark">
    {{!-- parágrafo de texto --}}
    <p>Notes &copy; 2021</p>
  </footer>
  {{!-- JavaScript do Bootstrap (faz o menu recolhível funcionar) --}}
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.1/dist/js/bootstrap.bundle.min.js" integrity="sha384-gtEjrD/SeCtmISkJkNUaaKMoLD0//ElJ19smozuHV6z3Iehds+3Ulb9Bn9Plx0x4" crossorigin="anonymous"></script>
</body>
</html>